{
  "name": "Studio — Medical Ops · Neon",
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.114.json",
  "dataColors": ["#2DE1C2", "#4C8DFF", "#A6E22E", "#FF6B9D", "#FFB020", "#7C5CFF", "#38BDF8", "#F65C6C"],
  "foreground": "#EAF2FF",
  "foregroundNeutralSecondary": "#8FA3B8",
  "foregroundNeutralTertiary": "#5C6B7E",
  "background": "#0A0E14",
  "backgroundLight": "#121821",
  "backgroundNeutral": "#1E2A38",
  "tableAccent": "#2DE1C2",
  "good": "#A6E22E",
  "neutral": "#FFB020",
  "bad": "#F65C6C",
  "maximum": "#2DE1C2",
  "minimum": "#1E2A38",
  "textClasses": {
    "callout":  { "fontFace": "DIN", "fontSize": 30, "color": "#FFFFFF" },
    "title":    { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#EAF2FF" },
    "header":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#8FA3B8" },
    "label":    { "fontFace": "Segoe UI", "fontSize": 10, "color": "#8FA3B8" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#121821" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1E2A38" } }, "radius": 8 }],
        "dropShadow": [{ "show": true, "preset": "Custom", "color": { "solid": { "color": "#000000" } }, "position": "Outer", "angle": 90, "shadowSpread": 4, "shadowBlur": 28, "transparency": 55 }],
        "visualHeader": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#EAF2FF" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold", "alignment": "left", "background": { "solid": { "color": "#121821" } } }],
        "visualTooltip": [{ "type": "Default", "titleFontColor": { "solid": { "color": "#EAF2FF" } }, "valueFontColor": { "solid": { "color": "#8FA3B8" } }, "background": { "solid": { "color": "#0A0E14" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0A0E14" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0A0E14" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#121821" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1E2A38" } }, "radius": 12 }],
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 32, "fontFamily": "DIN" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#8FA3B8" } }, "fontSize": 10, "fontFamily": "Segoe UI" }]
      }
    },
    "kpi": {
      "*": {
        "trendline": [{ "show": true, "transparency": 40 }],
        "goals": [{ "show": true }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3, "showMarker": false, "lineStyle": "solid" }],
        "categoryAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#5C6B7E" } }, "gridlineShow": false }],
        "valueAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#5C6B7E" } }, "gridlineColor": { "solid": { "color": "#1E2A38" } }, "gridlineStyle": "dotted" }]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#2DE1C2" } } }],
        "categoryAxis": [{ "gridlineShow": false, "labelColor": { "solid": { "color": "#5C6B7E" } } }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#1E2A38" } }, "gridlineStyle": "dotted" }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1E2A38" } }, "radius": 999 }],
        "items": [{ "fontColor": { "solid": { "color": "#8FA3B8" } }, "background": { "solid": { "color": "#121821" } } }]
      }
    }
  }
}
