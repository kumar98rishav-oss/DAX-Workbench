<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows + WinForms: the bridge is now a TRAY APP serving the
         embedded Studio UI, not a console API. The ~40MB the WindowsDesktop
         framework adds back is the cost of a real system-tray experience.
         Sdk.NET (not Sdk.Web) + an AspNetCore FrameworkReference is the
         supported hybrid for web-server-inside-desktop-app. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Analysis Services client libs are x64-only. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>pbi-desktop-bridge</AssemblyName>
    <RootNamespace>PbiDesktopBridge</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The built Studio frontend is embedded so ONE exe is the whole product. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- SQLBI's Dax.Model.Extractor (via AMO) reads Assembly.Location, which is
         EMPTY under PublishSingleFile — it surfaces as a "path is empty" error
         during VertiPaq extraction. Extracting all bundled content to a temp dir
         on launch populates Location so those libraries work. Still one file to
         ship; it just self-extracts on first run. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Read/write the Tabular model (TOM) + run DAX (ADOMD), .NET Core builds. -->
    <PackageReference Include="Microsoft.AnalysisServices.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <!-- VertiPaq Analyzer — SQLBI's OWN extraction library (MIT), the same code
         DAX Studio and the standalone VertiPaq Analyzer use. We read the model's
         storage metrics through it rather than re-deriving the DMV math, so the
         numbers match DAX Studio by construction. -->
    <PackageReference Include="Dax.Model.Extractor" Version="1.12.0" />
    <PackageReference Include="Dax.ViewModel" Version="1.12.0" />
    <PackageReference Include="Dax.ViewVpaExport" Version="1.12.0" />
    <PackageReference Include="Dax.Vpax" Version="1.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- wwwroot/ is the Studio's vite build output, copied in by build-full.cmd. -->
    <EmbeddedResource Include="wwwroot\**\*" />
    <EmbeddedResource Include="assets\icon.png" />
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
