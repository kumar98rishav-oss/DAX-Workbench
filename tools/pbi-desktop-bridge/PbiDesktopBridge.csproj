<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- net8.0, NOT net8.0-windows: the -windows TFM drags in the WindowsDesktop
         framework (WPF + WinForms, ~43MB of PresentationFramework/System.Windows.Forms)
         that a headless HTTP service never touches. Verified TOM + ADOMD still work.
         Analysis Services client libs are x64-only. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>pbi-desktop-bridge</AssemblyName>
    <RootNamespace>PbiDesktopBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read/write the Tabular model (TOM) + run DAX (ADOMD), .NET Core builds. -->
    <PackageReference Include="Microsoft.AnalysisServices.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient.NetCore.retail.amd64" Version="19.84.1" />
  </ItemGroup>

</Project>
