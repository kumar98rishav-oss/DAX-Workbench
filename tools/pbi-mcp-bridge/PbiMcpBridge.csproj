<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Analysis Services client libs are x64-only. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>pbi-mcp-bridge</AssemblyName>
    <RootNamespace>PbiMcpBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP C# SDK (prerelease). Bump to the newest if restore complains. -->
    <PackageReference Include="ModelContextProtocol" Version="0.1.0-preview.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

    <!-- Read/write the Tabular model (TOM) + run DAX (ADOMD), .NET Core builds. -->
    <PackageReference Include="Microsoft.AnalysisServices.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient.NetCore.retail.amd64" Version="19.84.1" />
  </ItemGroup>

</Project>
